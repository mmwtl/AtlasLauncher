<?xml version="1.0" encoding="utf-8"?>
<!-- Event types are set at runtime from AtlasLauncher settings; none are requested while the feature is off.
     Only Launcher3 events can reach the service, and it never reads window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/stock_home_redirect_description"
    android:notificationTimeout="0"
    android:packageNames="com.android.launcher3" />
